{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "crons": [
    {
      "path": "/api/comunicados/processar",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/lembretes/processar",
      "schedule": "0 9 * * *"
    }
  ]
}
